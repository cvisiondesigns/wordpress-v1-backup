---
---
<div class="relative bg-[#f19917] overflow-hidden min-h-[500px] flex items-center">
    <!-- Simplified Hero Section (Static version of the tilted slider) -->
    <div class="container mx-auto px-4 grid md:grid-cols-2 gap-12 items-center">
        <div class="text-white space-y-4">
            <h2 class="text-5xl font-serif tracking-widest">粹。平面</h2>
            <p class="text-xl opacity-90">/ 平面宇宙裡</p>
            <p class="text-xl opacity-90">/ 用圖像訴說著表達</p>
            <div class="pt-8">
                <a href="/graphic-design" class="inline-block border border-white px-8 py-3 hover:bg-white hover:text-[#f19917] transition-all tracking-widest uppercase text-sm">Explore / 探索</a>
            </div>
        </div>
        <div class="relative group">
            <div class="flex gap-4 transform rotate-[-5deg]">
                <img src="/wp-content/uploads/index-slightshow/01.jpg" alt="Graphic Design 01" class="w-2/3 shadow-2xl rounded-sm" />
                <img src="/wp-content/uploads/index-slightshow/02.jpg" alt="Graphic Design 02" class="w-1/2 shadow-xl rounded-sm -mt-12" />
            </div>
        </div>
    </div>
</div>

<section class="py-24 bg-[#fff4cb] text-center">
    <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-4xl font-serif text-[#2D2E33] mb-8 tracking-[0.2em]">澄粹原流而敷化</h2>
        <div class="w-[1px] h-12 bg-[#ffc04c] mx-auto mb-12"></div>
        
        <div class="flex items-center justify-center gap-8 mb-16">
            <div class="hidden md:block flex-1 h-[1px] bg-[#ffc04c]"></div>
            <h4 class="bg-[#ffc04c] text-white px-12 py-2 rounded-full text-sm tracking-widest uppercase">新 NEWS 敷</h4>
            <div class="hidden md:block flex-1 h-[1px] bg-[#ffc04c]"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-12">
            <div class="space-y-4 group">
                <div class="aspect-square overflow-hidden rounded-full border-4 border-[#ffc04c]/30 group-hover:border-[#ff9600] transition-all p-2">
                    <img src="/wp-content/uploads/cat.jpg" alt="守護天使" class="w-full h-full object-cover rounded-full" />
                </div>
                <h3 class="text-lg tracking-widest">喵守護天使</h3>
            </div>
            <div class="space-y-4 group">
                <div class="aspect-square overflow-hidden rounded-full border-4 border-[#ffc04c]/30 group-hover:border-[#ff9600] transition-all p-2">
                    <img src="/wp-content/uploads/works/Graphic/66Planet-cvision.webp" alt="66號星球" class="w-full h-full object-cover rounded-full" />
                </div>
                <h3 class="text-lg tracking-widest">66號星球</h3>
            </div>
            <div class="space-y-4 group">
                <div class="aspect-square overflow-hidden rounded-full border-4 border-[#ffc04c]/30 group-hover:border-[#ff9600] transition-all p-2">
                    <img src="/wp-content/uploads/works/Package/Package_RoadCones-paint.webp" alt="手指滑板" class="w-full h-full object-cover rounded-full" />
                </div>
                <h3 class="text-lg tracking-widest">手指滑板</h3>
            </div>
        </div>
    </div>
</section>

<!-- Works Showcase Sections (Simplified) -->
<section class="py-24 bg-white overflow-hidden">
    <div class="container mx-auto px-4">
        <!-- Web Design Section -->
        <div class="flex flex-col md:flex-row items-center gap-16 mb-32">
            <div class="md:w-1/2 relative">
                <div class="aspect-square overflow-hidden rounded-tl-[80px] rounded-br-[80px] rounded-tr-[55px] rounded-bl-[55px] border-[15px] border-[#ffe89f] transform rotate-[-45deg] scale-90">
                   <img src="/wp-content/uploads/index-slightshow/05.jpg" alt="Web Design" class="w-full h-full object-cover transform rotate-[45deg] scale-125" />
                </div>
            </div>
            <div class="md:w-1/2 space-y-6">
                <h1 class="text-5xl font-serif text-[#2D2E33]">站 Web 妝</h1>
                <p class="text-legacy-link text-sm uppercase tracking-widest transition-all">/ Web Gallery</p>
                <div class="w-48 h-[2px] bg-[#ffc04c] transform rotate-[-10deg]"></div>
                <p class="text-xl leading-relaxed text-[#545353] font-light">
                    影像細胞和代碼細胞交融<br/>
                    刻畫出一頁頁的<br/>
                    網站之維度空間
                </p>
                <div class="pt-8">
                    <a href="/works/web-design" class="inline-block bg-[#2d2e33] text-white px-12 py-3 hover:bg-legacy-blue transition-all tracking-widest text-sm skew-x-[-20deg]">
                        <span class="inline-block skew-x-[20deg]">GO ! 探索去 /</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Graphic Design Section (Reversed) -->
        <div class="flex flex-col md:flex-row-reverse items-center gap-16">
            <div class="md:w-1/2 relative">
                <div class="aspect-square overflow-hidden rounded-tl-[80px] rounded-br-[80px] rounded-tr-[55px] rounded-bl-[55px] border-[15px] border-[#ffe89f] transform rotate-[45deg] scale-90">
                   <img src="/wp-content/uploads/works/Graphic/66Planet-cvision.webp" alt="Graphic Design" class="w-full h-full object-cover transform rotate-[-45deg] scale-125" />
                </div>
            </div>
            <div class="md:w-1/2 space-y-6 text-right flex flex-col items-end">
                <h1 class="text-5xl font-serif text-[#2D2E33]">面 GraPhic 妝</h1>
                <p class="text-legacy-link text-sm uppercase tracking-widest">GraPhic Gallery /</p>
                <div class="w-48 h-[2px] bg-[#ffc04c] transform rotate-[10deg]"></div>
                <p class="text-xl leading-relaxed text-[#545353] font-light">
                    思緒與情感匯聚舞躍著<br/>
                    盪漾出一張張的<br/>
                    平面之維度視界
                </p>
                <div class="pt-8">
                    <a href="/graphic-design" class="inline-block bg-[#2d2e33] text-white px-12 py-3 hover:bg-legacy-blue transition-all tracking-widest text-sm skew-x-[20deg]">
                        <span class="inline-block skew-x-[-20deg]">GO ! 探索去 /</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-32 bg-[#D86742] text-white text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-black/10"></div>
    <div class="container mx-auto px-4 relative z-10 space-y-8">
        <h3 class="text-4xl font-serif leading-relaxed tracking-widest">
            願在視線交匯的片刻<br/>找回你我的溫度
        </h3>
        <div class="pt-12">
            <a href="/about" class="inline-block border-b border-white pb-2 hover:text-[#fff4cb] hover:border-[#fff4cb] transition-all tracking-[0.5em] uppercase text-sm font-bold">
                GO ! 探索視界 /
            </a>
        </div>
    </div>
</section>
