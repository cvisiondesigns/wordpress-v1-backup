---
const packageWorks = [
    {
        title: '手指滑板-Q版idol',
        subtitle: 'Fingerboard Chibi idol',
        img: `${import.meta.env.BASE_URL}wp-content/uploads/works/Package/Packgae_FingerSkateboard.png`,
        desc: '繪製了一個Q版idol，想在手指滑板加入自己喜愛的Q版idol，並將其轉印在手指滑板上，做成獨特的Q版idol手指板。'
    },
    {
        title: '茶包裝 Black Tea',
        subtitle: 'Black Tea Packaging',
        img: `${import.meta.env.BASE_URL}wp-content/uploads/works/Package/Packgae_BlackTea-Ariel.png`,
        desc: '喝皇家伯爵紅茶一邊研究Illu，突然想到某種風格於是結合了當時喜愛的idol，嘗試做了牛奶罐外觀包裝。'
    },
    {
        title: '爆米花-Q版公仔 POP Corn',
        subtitle: 'POP Corn Packaging',
        img: `${import.meta.env.BASE_URL}wp-content/uploads/works/Package/Packgae_POpCornModel.png`,
        desc: '風味爆米花外包裝，結合各個地方文化的特色並繪製了不同風格的Q版公仔。'
    },
    {
        title: '咖啡 Venus Coffee',
        subtitle: 'Venus Coffee Logo & Package',
        img: `${import.meta.env.BASE_URL}wp-content/uploads/works/Package/Packgae_Coffee.png`,
        desc: '維納斯咖啡，假想一個虛擬咖啡並為其繪製LOGO，做成玻璃瓶外包裝。'
    }
];

const finishedProducts = [
    { title: '手指滑板三角錐道具包裝', subtitle: 'Road Cones Packaging', img: `${import.meta.env.BASE_URL}wp-content/uploads/works/Package/Package_RoadCones.png` },
    { title: '手指滑板手作板塗鴉喵', subtitle: 'Graffiti Meow', img: `${import.meta.env.BASE_URL}wp-content/uploads/works/Package/Fingerboard-graffiti-skatcat.jpg` },
    { title: '手指滑板喵呼嚕嚕', subtitle: 'MEOW~Hululu Hand Bruning', img: `${import.meta.env.BASE_URL}wp-content/uploads/works/Package/Fingerskatebord-meowhululu.jpg` },
    { title: '珍珠耳環喵手工繪燒', subtitle: 'Cat With a Pearl Earring', img: `${import.meta.env.BASE_URL}wp-content/uploads/works/Package/Fingerskatboard_CatWithaPearlEarring.png` },
    { title: 'UV膠手作有顆蛋', subtitle: 'UV-Fried Egg', img: `${import.meta.env.BASE_URL}wp-content/uploads/works/Package/Package_uv-egg.jpg` },
    { title: '低膠樹脂手作小鹿', subtitle: 'AB EPOXY Deer', img: `${import.meta.env.BASE_URL}wp-content/uploads/works/Package/Package_ab-deer.jpg` }
];
---
<section class="py-16 bg-white min-h-screen">
    <div class="container mx-auto px-4">
        <div class="mb-16">
            <h1 class="text-5xl font-serif text-[#f48f00] mb-4">.PackAGe DeSiGN 包妝</h1>
            <div class="flex flex-col md:flex-row items-end gap-8">
                 <div class="md:w-2/3">
                    <img src={`${import.meta.env.BASE_URL}wp-content/uploads/works/Package/works-backpage_cover.jpg`} alt="Package Design Cover" class="w-full rounded-2xl shadow-lg" />
                 </div>
                 <div class="md:w-1/3 text-right">
                    <h2 class="text-3xl font-serif text-[#f48f00] border-b-2 border-[#f48f00] pb-2 inline-block">包妝裝扮化妝術</h2>
                 </div>
            </div>
        </div>

        <div class="space-y-24 max-w-5xl mx-auto">
            {packageWorks.map((work, index) => (
                <div class={`flex flex-col md:flex-row items-center gap-12 ${index % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
                    <div class="md:w-1/2">
                        <img src={work.img} alt={work.title} class="w-full rounded-2xl shadow-xl hover:scale-105 transition-transform duration-500" />
                    </div>
                    <div class="md:w-1/2 space-y-6">
                        <h3 class="text-3xl font-serif text-[#2D2E33] leading-tight">{work.title}</h3>
                        <p class="text-gray-600 leading-relaxed text-lg">{work.desc}</p>
                        <div class="pt-4">
                            <span class="inline-block border-b-2 border-[#f48f00] pb-1 text-[#f48f00] font-bold tracking-widest text-sm uppercase">
                                {work.subtitle}
                            </span>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<section class="py-24 bg-[#FF9600] text-white">
    <div class="container mx-auto px-4">
        <div class="flex items-center justify-center gap-8 mb-16">
             <div class="h-px bg-white/30 flex-1"></div>
             <h2 class="text-3xl font-serif tracking-widest">Finished Product 成品</h2>
             <div class="h-px bg-white/30 flex-1"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {finishedProducts.map((product) => (
                <div class="group relative aspect-square rounded-2xl overflow-hidden bg-white/10">
                    <img src={product.img} alt={product.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-end p-8 text-center">
                        <h3 class="text-xl font-serif mb-2">{product.title}</h3>
                        <p class="text-sm opacity-70">{product.subtitle}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
